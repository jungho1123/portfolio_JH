# Neon: runtime pooled URL and migration direct URL. Keep each environment isolated.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio"
DATABASE_URL_UNPOOLED=""
DB_POOL_MAX="5"

# Exact application origin. Production must use HTTPS.
BETTER_AUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Numeric GitHub user ID (not username, email or display name).
ADMIN_GITHUB_ID=""
# A separate token with only public GitHub access; never reuse OAuth access tokens.
GITHUB_TOKEN=""

# Connect a PRIVATE Vercel Blob store to the same environment.
BLOB_READ_WRITE_TOKEN=""
RESUME_MAX_BYTES="10000000"
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
